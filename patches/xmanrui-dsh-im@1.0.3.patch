new file mode 100644
index 0000000000..6fae688809
--- /dev/null
+++ b/desktop-workspace.mjs
@@ -0,0 +1,54 @@
+/** Desktop workspace defaults for the bundled IM platforms. */
+import { homedir } from 'node:os';
+import { isAbsolute, join } from 'node:path';
+import {
+  createImHostPlugin as createUpstreamPlugin,
+  inject as upstreamInject,
+  name,
+} from './lib/index.js';
+import { apply as applyQqWithSpeech } from './plugin-src/host/channels/qq/index.mjs';
+
+export { name };
+export const inject = [...upstreamInject, 'speech'];
+
+const BOT_CHANNELS = [
+  'feishu', 'weixin', 'dingtalk', 'wecom', 'qq',
+  'slack', 'telegram', 'discord', 'whatsapp',
+];
+
+/**
+ * Create the IM plugin with desktop defaults for unassigned bot workspaces.
+ * Saved workspaces and explicit per-platform workspace settings take precedence.
+ * @param internals - upstream platform implementations, when supplied.
+ * @returns the plugin with its existing metadata and lifecycle ownership.
+ */
+export function createImHostPlugin(internals) {
+  const plugin = createUpstreamPlugin({
+    ...internals,
+    applyQq: internals?.applyQq ?? applyQqWithSpeech,
+  });
+  return Object.freeze({
+    ...plugin,
+    async apply(ctx, config = {}) {
+      const desktop = process.env.DSH_DESKTOP_DIR ?? join(homedir(), 'Desktop');
+      if (!isAbsolute(desktop)) {
+        throw new Error('DSH_DESKTOP_DIR must be an absolute directory path');
+      }
+      const channels = Object.fromEntries(BOT_CHANNELS.map((channel) => [channel, {
+        ...config[channel],
+        workspace: config[channel]?.workspace ?? desktop,
+      }]));
+      return plugin.apply(ctx, { ...config, ...channels });
+    },
+  });
+}
+
+/**
+ * Mount the bundled IM plugin with Host desktop workspace defaults.
+ * @param ctx - the Cordis Host context.
+ * @param config - upstream IM settings, including per-platform overrides.
+ * @returns completion of the upstream plugin's startup.
+ */
+export async function apply(ctx, config) {
+  return createImHostPlugin().apply(ctx, config);
+}

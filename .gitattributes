# The repo's canonical text form is LF, enforced at checkout too: no smudge
# boundary between working tree and repo, so byte-level gates (verify-*
# comparisons, blob hashing, coverage offsets) see one form on every host.
# Windows command scripts require CRLF in the working tree for cmd.exe; the
# override after the default keeps the in-repo form normalized as text.
* text=auto eol=lf
*.cmd text eol=crlf

*.pdf binary

# Unified-diff patch files preserve upstream indentation after their
# context markers, which Git must not reinterpret as repository whitespace.
patches/*.patch -whitespace
patches/dsh-skill-mcp-panel@2.0.4.patch -text
third-party/dsh-univer-office/runtime.patch -whitespace
packages/host/teacher-workbench/third-party/mathml2omml/colors.patch -whitespace

# Preserve the bundled upstream skill distribution byte-for-byte; its inventory
# and attribution tests verify the unmodified release contents.
packages/skill/skill-ppt-master/assets/ppt-master/** -text -whitespace

# Pairing records are generated from the three confirmed owner-blob pairs.
# The worktree-local installer registers the fail-closed driver command.
*.i18n.yaml merge=dsh-translation-pairing

# The persistence catalog is the readable projection of these generated schemas.
docs/persistence-schema.json linguist-generated=true
docs/persistence-changes/*.schema.json linguist-generated=true
docs/persistence-changes/releases/*.schema.json linguist-generated=true
docs/persistence-changes/historical-formats/*.schema.json linguist-generated=true

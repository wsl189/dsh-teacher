+/** Native Office equations and Latin font defaults for exported Word documents. */
+import { mkdtemp, readFile, rename, rm, writeFile } from 'node:fs/promises';
+import { dirname, join } from 'node:path';
+import { DOMParser, XMLSerializer } from '@xmldom/xmldom';
+import { strFromU8, strToU8, unzipSync, zipSync } from 'fflate';
+import katex from 'katex';
+import { mml2omml } from 'mathml2omml';
+
+const W = 'http://schemas.openxmlformats.org/wordprocessingml/2006/main';
+const M = 'http://schemas.openxmlformats.org/officeDocument/2006/math';
+const XML = 'http://www.w3.org/XML/1998/namespace';
+const LATIN_FONT = 'Times New Roman';
+const MATH_FONT = 'Cambria Math';
+
+function parseXml(xml) {
+  return new DOMParser({ onError(level, message) { throw new Error(`Invalid Word XML: ${message}`); } })
+    .parseFromString(xml, 'application/xml');
+}
+
+function elements(parent) {
+  return Array.from(parent.childNodes).filter(node => node.nodeType === 1);
+}
+
+function child(parent, ns, local) {
+  return elements(parent).find(node => node.namespaceURI === ns && node.localName === local);
+}
+
+function ensure(parent, ns, name) {
+  const existing = child(parent, ns, name.slice(name.indexOf(':') + 1));
+  if (existing) return existing;
+  const node = parent.ownerDocument.createElementNS(ns, name);
+  parent.appendChild(node);
+  return node;
+}
+
+function setProperty(parent, ns, name, value) {
+  const node = ensure(parent, ns, name);
+  node.setAttributeNS(ns, `${name.split(':')[0]}:val`, value);
+  if (ns === W && parent.localName === 'rPr') {
+    const order = ['rStyle', 'rFonts', 'b', 'bCs', 'i', 'iCs', 'color', 'sz', 'szCs', 'shd'];
+    const following = elements(parent).find(item => order.indexOf(item.localName) > order.indexOf(node.localName));
+    if (following) parent.insertBefore(node, following);
+  }
+}
+
+function fonts(properties, latin, overwrite = false) {
+  const node = ensure(properties, W, 'w:rFonts');
+  for (const name of ['ascii', 'hAnsi']) {
+    if (overwrite || (!node.hasAttributeNS(W, name) && !node.hasAttributeNS(W, `${name}Theme`))) {
+      node.setAttributeNS(W, `w:${name}`, latin);
+      node.removeAttributeNS(W, `${name}Theme`);
+    }
+  }
+  const next = elements(properties).find(item => item.localName !== 'rStyle' && item !== node);
+  if (next) properties.insertBefore(node, next);
+}
+
+/** Explicit TeX delimiters avoid treating currency amounts as equations. */
+function equationSpans(text) {
+  const spans = [];
+  let open;
+  for (const match of text.matchAll(/\\([()[\]])/gu)) {
+    let preceding = 0;
+    for (let i = match.index - 1; i >= 0 && text[i] === '\\'; i--) preceding++;
+    if (preceding % 2 === 1) continue;
+    const delimiter = match[1];
+    if (delimiter === '(' || delimiter === '[') {
+      if (open) throw new Error('DOCX_EQUATION_INVALID: nested equation delimiters');
+      open = { start: match.index, display: delimiter === '[' };
+    } else {
+      if (!open || delimiter !== (open.display ? ']' : ')')) throw new Error('DOCX_EQUATION_INVALID: unmatched equation delimiter');
+      spans.push({ ...open, end: match.index + 2, latex: text.slice(open.start + 2, match.index) });
+      open = undefined;
+    }
+  }
+  if (open) throw new Error('DOCX_EQUATION_INVALID: equation must close within one uninterrupted paragraph text range');
+  return spans;
+}
+
+function nativeEquation(span, sourceProperties) {
+  if (span.latex.trim() === '') throw new Error('DOCX_EQUATION_INVALID: empty equation');
+  let root;
+  try {
+    const rendered = katex.renderToString(span.latex, {
+      output: 'mathml', displayMode: span.display, throwOnError: true, trust: false, strict: 'ignore',
+    });
+    const math = parseXml(rendered).getElementsByTagName('math').item(0);
+    if (!math) throw new Error('No MathML returned');
+    for (const annotation of Array.from(math.getElementsByTagName('annotation'))) annotation.parentNode.removeChild(annotation);
+    root = parseXml(mml2omml(new XMLSerializer().serializeToString(math))).documentElement;
+    if (root?.namespaceURI !== M || root.localName !== 'oMath') throw new Error('No native Office equation returned');
+  } catch (cause) {
+    throw new Error(`DOCX_EQUATION_INVALID: equation ${JSON.stringify(span.latex)}: ${cause instanceof Error ? cause.message : String(cause)}. Correct the TeX while preserving its mathematical meaning; keep the equation markers and operators.`, { cause });
+  }
+  for (const run of Array.from(root.getElementsByTagNameNS(M, 'r'))) {
+    const properties = ensure(run, W, 'w:rPr');
+    for (const prop of elements(sourceProperties ?? properties).filter(node => ['sz', 'szCs', 'color', 'b', 'bCs'].includes(node.localName))) {
+      if (!child(properties, W, prop.localName)) properties.appendChild(root.ownerDocument.importNode(prop, true));
+    }
+    fonts(properties, MATH_FONT, true);
+    const text = child(run, M, 't');
+    const mathProperties = child(run, M, 'rPr');
+    if (mathProperties && run.firstChild !== mathProperties) run.insertBefore(mathProperties, run.firstChild);
+    run.insertBefore(properties, text);
+  }
+  formatLatinMath(root);
+  return root;
+}
+
+/** Keep mathematical operators in math runs while giving Latin tokens an explicit text font. */
+function formatLatinMath(root) {
+  for (const run of Array.from(root.getElementsByTagNameNS(M, 'r'))) {
+    const properties = child(run, M, 'rPr');
+    const script = properties && child(properties, M, 'scr')?.getAttributeNS(M, 'val');
+    if (script && script !== 'roman') continue;
+    const text = child(run, M, 't');
+    if (!text || !/[A-Za-z0-9]/u.test(text.textContent)) continue;
+    const style = properties && child(properties, M, 'sty')?.getAttributeNS(M, 'val');
+    const normal = properties && child(properties, M, 'nor');
+    for (const token of text.textContent.match(/[A-Za-z]+|[0-9]+|[^A-Za-z0-9]+/gu)) {
+      const copy = run.cloneNode(true);
+      child(copy, M, 't').textContent = token;
+      if (/^[A-Za-z0-9]+$/u.test(token)) {
+        const mathPr = ensure(copy, M, 'm:rPr');
+        if (copy.firstChild !== mathPr) copy.insertBefore(mathPr, copy.firstChild);
+        const nor = ensure(mathPr, M, 'm:nor');
+        nor.setAttributeNS(M, 'm:val', '1');
+        if (mathPr.firstChild !== nor) mathPr.insertBefore(nor, mathPr.firstChild);
+        const wordPr = ensure(copy, W, 'w:rPr');
+        fonts(wordPr, LATIN_FONT, true);
+        const italic = style === 'i' || style === 'bi' || (!style && !normal && /^[A-Za-z]+$/u.test(token));
+        setProperty(wordPr, W, 'w:i', italic ? '1' : '0');
+        if (style === 'b' || style === 'bi') setProperty(wordPr, W, 'w:b', '1');
+      }
+      run.parentNode.insertBefore(copy, run);
+    }
+    run.parentNode.removeChild(run);
+  }
+}
+
+function textOf(run) {
+  return elements(run).filter(node => node.namespaceURI === W && node.localName === 't').map(node => node.textContent).join('');
+}
+
+function isTextRun(node) {
+  return node.namespaceURI === W && node.localName === 'r' && elements(node).every(
+    item => item.namespaceURI === W && ['rPr', 't'].includes(item.localName),
+  );
+}
+
+function sliceRun(run, text) {
+  const copy = run.cloneNode(false);
+  const properties = child(run, W, 'rPr');
+  if (properties) copy.appendChild(properties.cloneNode(true));
+  const content = copy.ownerDocument.createElementNS(W, 'w:t');
+  content.setAttributeNS(XML, 'xml:space', 'preserve');
+  content.textContent = text;
+  copy.appendChild(content);
+  return copy;
+}
+
+function convertGroup(parent, runs) {
+  const text = runs.map(textOf).join('');
+  const spans = equationSpans(text);
+  if (spans.length === 0) return;
+  const positions = [];
+  let offset = 0;
+  for (const run of runs) {
+    const content = textOf(run);
+    positions.push({ run, start: offset, end: offset + content.length, content });
+    offset += content.length;
+  }
+  const output = [];
+  function appendText(start, end) {
+    for (const position of positions) {
+      const a = Math.max(start, position.start), b = Math.min(end, position.end);
+      if (a < b) output.push(sliceRun(position.run, position.content.slice(a - position.start, b - position.start)));
+    }
+  }
+  offset = 0;
+  for (const span of spans) {
+    appendText(offset, span.start);
+    const source = positions.find(position => position.start <= span.start && position.end > span.start);
+    const equation = parent.ownerDocument.importNode(nativeEquation(span, source && child(source.run, W, 'rPr')), true);
+    if (span.display && text.slice(0, span.start).trim() === '' && text.slice(span.end).trim() === '') {
+      const block = parent.ownerDocument.createElementNS(M, 'm:oMathPara');
+      block.appendChild(equation);
+      output.push(block);
+    } else output.push(equation);
+    offset = span.end;
+  }
+  appendText(offset, text.length);
+  for (const node of output) parent.insertBefore(node, runs[0]);
+  for (const run of runs) parent.removeChild(run);
+}
+
+function convertParagraph(paragraph) {
+  let group = [];
+  for (const node of elements(paragraph)) {
+    if (isTextRun(node)) group.push(node);
+    else {
+      convertGroup(paragraph, group);
+      group = [];
+      // Hyperlinks retain their relationship and run formatting.
+      if (node.namespaceURI === W && node.localName === 'hyperlink') convertParagraph(node);
+    }
+  }
+  convertGroup(paragraph, group);
+}
+
+/**
+ * Set inherited Latin fonts and convert explicitly delimited TeX to editable OMML.
+ * @param {Uint8Array} bytes - DOCX from the Office exporter.
+ * @returns {Uint8Array} DOCX retaining tables, media, relationships, and explicit text fonts.
+ * @throws {Error} when marked math cannot be converted without dropping content.
+ */
+export function normalizeWordExport(bytes) {
+  const parts = unzipSync(bytes);
+  if (!parts['word/document.xml'] || !parts['word/styles.xml']) throw new Error('DOCX_INVALID: missing document or styles');
+  const styles = parseXml(strFromU8(parts['word/styles.xml']));
+  const docDefaults = ensure(styles.documentElement, W, 'w:docDefaults');
+  if (styles.documentElement.firstChild !== docDefaults) styles.documentElement.insertBefore(docDefaults, styles.documentElement.firstChild);
+  const defaults = ensure(ensure(docDefaults, W, 'w:rPrDefault'), W, 'w:rPr');
+  fonts(defaults, LATIN_FONT, true);
+  parts['word/styles.xml'] = strToU8(new XMLSerializer().serializeToString(styles));
+  for (const name of Object.keys(parts).filter(name => /^word\/(?:document|header\d*|footer\d*|footnotes|endnotes)\.xml$/u.test(name))) {
+    const document = parseXml(strFromU8(parts[name]));
+    for (const paragraph of Array.from(document.getElementsByTagNameNS(W, 'p'))) convertParagraph(paragraph);
+    for (const text of Array.from(document.getElementsByTagNameNS(W, 't'))) {
+      if (equationSpans(text.textContent).length > 0) {
+        throw new Error('DOCX_EQUATION_INVALID: equation text shares an unsupported drawing or field run');
+      }
+    }
+    parts[name] = strToU8(new XMLSerializer().serializeToString(document));
+  }
+  return zipSync(parts);
+}
+
+/**
+ * Publish a Word export only after font and equation processing succeeds.
+ * @param {string} output - authorized destination filename.
+ * @param {(temporaryOutput: string) => Promise<void>} writer - upstream DOCX writer.
+ * @returns {Promise<void>} completed publication; conversion failure preserves any existing output.
+ */
+export async function exportNativeWord(output, writer) {
+  const directory = await mkdtemp(join(dirname(output), '.dsh-word-'));
+  try {
+    const temporary = join(directory, 'document.docx');
+    await writer(temporary);
+    const bytes = normalizeWordExport(await readFile(temporary));
+    await writeFile(temporary, bytes, { mode: 0o600 });
+    await rename(temporary, output);
+  } finally {
+    await rm(directory, { recursive: true, force: true, maxRetries: 3 });
+  }
+}
